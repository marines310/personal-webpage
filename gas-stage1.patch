diff --git a/src/styles.css b/src/styles.css
index dd50771..b618967 100644
--- a/src/styles.css
+++ b/src/styles.css
@@ -909,3 +909,68 @@ body {
   min-height: 1em;
   text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
 }
+
+/* ---------------------------------------------------------------------------
+   Fuel gauge
+   ---------------------------------------------------------------------------
+   Under the speed, inside the same panel, because that is where the eye
+   already goes. Deliberately small: it is a background worry, not a callout,
+   and it is on screen the whole time - so it has to be readable at a glance
+   and ignorable the rest of the time.
+
+   Three states, and the colour is the whole of the message: green while you
+   are fine, amber at a quarter, red at empty. The width animates so a fill
+   is something you watch rather than something that has happened.
+*/
+#fuel {
+  margin-top: 9px;
+}
+
+#fuel.hidden {
+  display: none;
+}
+
+#fuel-bar {
+  width: 100%;
+  height: 6px;
+  border-radius: 3px;
+  background: rgba(255, 255, 255, 0.16);
+  overflow: hidden;
+}
+
+#fuel-fill {
+  height: 100%;
+  width: 100%;
+  border-radius: 3px;
+  background: #43d98b;
+  transition: width 0.25s linear, background-color 0.3s ease;
+}
+
+#fuel.low #fuel-fill {
+  background: #ffb547;
+}
+
+#fuel.empty #fuel-fill {
+  background: #ff5f56;
+}
+
+/* While the pump is running, so a fill reads as active rather than as the
+   needle happening to move. */
+#fuel.filling #fuel-fill {
+  animation: fuel-pulse 1.1s ease-in-out infinite;
+}
+
+@keyframes fuel-pulse {
+  0%, 100% { opacity: 1; }
+  50% { opacity: 0.55; }
+}
+
+#fuel-label {
+  margin-top: 4px;
+  font-size: 0.6rem;
+  letter-spacing: 0.14em;
+  color: rgba(255, 255, 255, 0.55);
+}
+
+#fuel.low #fuel-label { color: #ffb547; }
+#fuel.empty #fuel-label { color: #ff5f56; }
